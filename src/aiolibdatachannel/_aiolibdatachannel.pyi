    @property
    def handle(self) -> int: ...
    def close(self) -> None: ...
    def destroy(self) -> None: ...
    def create_data_channel(
        self,
        label: str,
        unordered: bool = ...,
        unreliable: bool = ...,
        max_packet_lifetime: int = ...,
        max_retransmits: int = ...,
        protocol: str = ...,
        negotiated: bool = ...,
        manual_stream: bool = ...,
        stream: int = ...,
