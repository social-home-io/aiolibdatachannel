"""Type stubs for the nanobind C extension."""

from collections.abc import Callable
from typing import Final

ERR_SUCCESS: Final[int]
ERR_INVALID: Final[int]
ERR_FAILURE: Final[int]
ERR_NOT_AVAIL: Final[int]
ERR_TOO_SMALL: Final[int]

def preload() -> None: ...
def cleanup() -> None: ...
def init_logger(level: int, callback: Callable[[int, str], None] | None) -> None: ...
def set_thread_pool_size(count: int) -> int: ...

